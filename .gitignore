# Apple credentials — must never be committed
*.p8
AuthKey_*.p8

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Expo local cache (machine-specific dev state)
.expo/
apps/*/.expo/

# Workspace packages must NOT have their own lockfiles — pnpm uses root pnpm-lock.yaml only
apps/*/package-lock.json
apps/*/yarn.lock
apps/*/pnpm-lock.yaml
apps/*/bun.lock

# Release signing — NEVER commit these (losing them = can't update the app)
*.keystore
!apps/mobile/android/app/debug.keystore
gradle.properties.local

# Environment variables — NEVER commit these (contain API keys)
.env
.env.local
.env.*.local
.env.production
.env.staging

# Firebase / FCM — admin/service-account JSONs contain private keys and MUST
# stay out of git. The Android `google-services.json` and iOS
# `GoogleService-Info.plist` files contain only public-ish Firebase config
# (project ID, sender ID, app API key) which is normal to ship inside an app,
# so they SHOULD be committed for EAS Build to find them.
**/liqzar-firebase-adminsdk-*.json
**/*-firebase-adminsdk-*.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
builds/
public/hero/_originals/
